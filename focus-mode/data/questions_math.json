      "questions": [
        {
          "q": "Solve for x: log₂(x) + log₂(x - 2) = 3",
          "options": [
            {"t": "x = 4", "c": true},
            {"t": "x = -2", "c": false},
            {"t": "x = 4 or x = -2", "c": false},
            {"t": "x = 8", "c": false}
          ],
          "exp": "log₂[x(x-2)] = 3 -> x² - 2x = 2³ = 8 -> x² - 2x - 8 = 0 -> (x-4)(x+2) = 0. Since log argument must be positive, x = 4."
        },
        {
          "q": "Evaluate: log₃(81) + log₅(125) - log₁₀(1000)",
          "options": [
            {"t": "4", "c": true},
            {"t": "5", "c": false},
            {"t": "7", "c": false},
            {"t": "3", "c": false}
          ],
          "exp": "4 + 3 - 3 = 4."
        },
        {
          "q": "The 4th term of an Arithmetic Progression (AP) is 13 and the 10th term is 31. Find the first term.",
          "options": [
            {"t": "4", "c": true},
            {"t": "3", "c": false},
            {"t": "5", "c": false},
            {"t": "7", "c": false}
          ],
          "exp": "a + 3d = 13 and a + 9d = 31. Subtracting gives 6d = 18 -> d = 3. Then a + 9 = 13 -> a = 4."
        },
        {
          "q": "Find the sum of the first 6 terms of the Geometric Progression (GP) 2, 6, 18, ...",
          "options": [
            {"t": "728", "c": true},
            {"t": "243", "c": false},
            {"t": "364", "c": false},
            {"t": "1456", "c": false}
          ],
          "exp": "a = 2, r = 3. S_n = a(r^n - 1) / (r - 1) = 2(3^6 - 1) / (3 - 1) = 729 - 1 = 728."
        }
      ]
