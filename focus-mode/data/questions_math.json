          ],
          "exp": "Factorize: (2x + 1)(x - 3) = 0 yielding x = 3 or x = -1/2."
        },
        {
          "q": "Find the sum of roots of the quadratic equation 3x² + 12x - 5 = 0.",
          "options": [
            {"t": "-4", "c": true},
            {"t": "4", "c": false},
            {"t": "-5/3", "c": false},
            {"t": "5/3", "c": false}
          ],
          "exp": "Sum of roots equals -b/a = -12 / 3 = -4."
        },
        {
          "q": "Solve the simultaneous equations: 2x + 3y = 12 and x - y = 1.",
          "options": [
            {"t": "x = 3, y = 2", "c": true},
            {"t": "x = 2, y = 3", "c": false},
            {"t": "x = 4, y = 1", "c": false},
            {"t": "x = 5, y = 0", "c": false}
          ],
          "exp": "From equation 2: x = y + 1. Substitute into equation 1: 2(y + 1) + 3y = 12 yielding 5y = 10 -> y = 2, x = 3."
        },
        {
          "q": "If f(x) = 2x - 5, find the inverse function f⁻¹(x).",
          "options": [
            {"t": "(x + 5)/2", "c": true},
            {"t": "(x - 5)/2", "c": false},
            {"t": "2x + 5", "c": false},
            {"t": "1 / (2x - 5)", "c": false}
          ],
          "exp": "Let y = 2x - 5, rearrange for x: x = (y + 5)/2, hence f⁻¹(x) = (x + 5)/2."
        },
        {
          "q": "Simplify completely: (3x²y³) / (9x⁴y)",
          "options": [
            {"t": "y² / 3x²", "c": true},
            {"t": "3y² / x²", "c": false},
            {"t": "x² / 3y²", "c": false},
            {"t": "1 / 3x²y", "c": false}
          ],
          "exp": "Divide coefficients and subtract exponents: (3/9) * x^(2-4) * y^(3-1) = (1/3) * x^(-2) * y^2 = y² / 3x²."
        }
      ]
